# Local extraction/build tools and third-party checkouts.
/.tools/
/.reference-*/

# Runtime logs and Python cache.
*.log
__pycache__/
*.py[cod]

# Tables compiled by the game from the versioned TXT sources.
/mods/**/data/global/excel/*.bin

# Credentials and personal game saves never belong in this repository.
.env
.env.*
*.pem
id_rsa*
id_ed25519*
*.d2s
*.key
